# Copy this file to `.env` and replace the example secrets before starting Compose.
# If reusing an existing mysql_data volume, DB_USER and DB_PASSWORD must match
# the MySQL account already stored in that database; changing these values does
# not change credentials inside an initialized volume.
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
DB_USER=doan_user
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=narration_db
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
CORS_ORIGIN=http://localhost:5173
